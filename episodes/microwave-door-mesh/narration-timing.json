  "phrases": [
    {
      "id": "hook",
      "text": "Why can you see through a microwave door if the microwaves are supposed to stay trapped inside?",
      "start": 0.106,
      "end": 4.411,
      "wordRange": [
        0,
        16
      ]
    },
    {
      "id": "mesh",
      "text": "Because that black metal mesh is doing something clever.",
      "start": 4.68,
      "end": 7.18,
      "wordRange": [
        17,
        25
      ]
    },
    {
      "id": "blocked",
      "text": "Microwave energy has a wavelength much larger than those tiny openings, so the conductive screen strongly blocks it from escaping.",
      "start": 7.549,
      "end": 14.321,
      "wordRange": [
        26,
        45
      ]
    },
    {
      "id": "light",
      "text": "Visible light has a vastly shorter wavelength, so light can pass through the holes and reach your eyes,",
      "start": 14.652,
      "end": 19.771,
      "wordRange": [
        46,
        63
      ]
    },
    {
      "id": "both",
      "text": "which means the same door can behave like a window for you while acting like a barrier for the energy cooking your leftovers.",
      "start": 20.058,
      "end": 25.917,
      "wordRange": [
        64,
        86
      ]
    },
    {
      "id": "payoff",
      "text": "Your microwave is basically wearing extremely nerdy sunglasses.",
      "start": 26.243,
      "end": 29.457,
      "wordRange": [
        87,
        94
      ]
    }
  ],
