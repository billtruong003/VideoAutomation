  "phrases": [
    {
      "id": "hook",
      "text": "Your jeans have a pocket designed for a gadget from the 1800s.",
      "start": 0.058,
      "end": 3.958,
      "wordRange": [
        0,
        11
      ]
    },
    {
      "id": "not-for",
      "text": "That tiny pocket inside the front pocket wasn't originally for coins, AirPods, or whatever else you can barely fit inside it.",
      "start": 3.958,
      "end": 10.296,
      "wordRange": [
        12,
        32
      ]
    },
    {
      "id": "watch-pocket",
      "text": "Early Levi's jeans included it as a watch pocket.",
      "start": 10.626,
      "end": 13.217,
      "wordRange": [
        33,
        41
      ]
    },
    {
      "id": "history",
      "text": "Pocket watches were common, and workers needed a small, protected place to keep them.",
      "start": 13.525,
      "end": 17.728,
      "wordRange": [
        42,
        55
      ]
    },
    {
      "id": "extinction",
      "text": "Wristwatches eventually took over. The pocket watch mostly disappeared, but the pocket survived.",
      "start": 17.728,
      "end": 22.435,
      "wordRange": [
        56,
        68
      ]
    },
    {
      "id": "payoff",
      "text": "So that useless little compartment on your jeans is basically a tiny fossil from a technology nobody carries anymore.",
      "start": 22.76,
      "end": 28.761,
      "wordRange": [
        69,
        87
      ]
    }
  ],
