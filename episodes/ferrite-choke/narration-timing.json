  "phrases": [
    {
      "id": "hook",
      "text": "There is a hard lump molded around your laptop charger cable, and it is surprisingly heavy for its size.",
      "start": 0.088,
      "end": 4.894,
      "wordRange": [
        0,
        18
      ]
    },
    {
      "id": "inside",
      "text": "Inside it is a ring of ferrite, an iron-based ceramic.",
      "start": 5.217,
      "end": 8.173,
      "wordRange": [
        19,
        28
      ]
    },
    {
      "id": "antenna",
      "text": "A power cable is a long piece of wire, and a long piece of wire is an antenna, so it picks up and radiates high-frequency noise it was never meant to carry.",
      "start": 8.465,
      "end": 15.985,
      "wordRange": [
        29,
        60
      ]
    },
    {
      "id": "filter",
      "text": "The ferrite ring lets your actual power pass straight through, and turns that noise into a tiny amount of heat.",
      "start": 16.217,
      "end": 21.38,
      "wordRange": [
        61,
        80
      ]
    },
    {
      "id": "payoff",
      "text": "It is a filter wrapped around a cable, stopping your charger from transmitting.",
      "start": 21.643,
      "end": 25.164,
      "wordRange": [
        81,
        93
      ]
    }
  ],
