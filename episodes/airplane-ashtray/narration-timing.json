  "phrases": [
    {
      "id": "hook",
      "text": "Smoking has been banned on flights for decades, and there is still an ashtray built into the airplane bathroom door.",
      "start": 0.071,
      "end": 5.031,
      "wordRange": [
        0,
        19
      ]
    },
    {
      "id": "notleftover",
      "text": "It is not a leftover nobody removed. Regulators require it, and a plane can be held on the ground over a broken one.",
      "start": 5.288,
      "end": 10.61,
      "wordRange": [
        20,
        42
      ]
    },
    {
      "id": "reasoning",
      "text": "The reasoning is bleak and completely correct.",
      "start": 10.825,
      "end": 12.718,
      "wordRange": [
        43,
        49
      ]
    },
    {
      "id": "cigarette",
      "text": "Somebody is eventually going to smoke in there anyway, and the only question is where the cigarette ends up.",
      "start": 13.05,
      "end": 16.801,
      "wordRange": [
        50,
        68
      ]
    },
    {
      "id": "bin",
      "text": "Without an ashtray, it goes in the bin, on top of the paper towels.",
      "start": 17.097,
      "end": 20.062,
      "wordRange": [
        69,
        82
      ]
    },
    {
      "id": "payoff",
      "text": "It is not there for smokers.",
      "start": 20.316,
      "end": 21.514,
      "wordRange": [
        83,
        88
      ]
    }
  ],
