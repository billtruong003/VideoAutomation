  "phrases": [
    {
      "id": "hook",
      "text": "Public toilet seats have a gap at the front, and the one in your house almost certainly does not.",
      "start": 0.071,
      "end": 3.962,
      "wordRange": [
        0,
        18
      ]
    },
    {
      "id": "written",
      "text": "It is written down.",
      "start": 4.224,
      "end": 4.938,
      "wordRange": [
        19,
        22
      ]
    },
    {
      "id": "code",
      "text": "The plumbing codes most of the country builds to call for open-front seats in public restrooms, and have for over fifty years.",
      "start": 5.234,
      "end": 10.825,
      "wordRange": [
        23,
        44
      ]
    },
    {
      "id": "hygiene",
      "text": "The gap keeps the seat clear of the area you are most likely to touch while wiping, which matters far more when hundreds of strangers share one seat.",
      "start": 11.131,
      "end": 17.918,
      "wordRange": [
        45,
        72
      ]
    },
    {
      "id": "pool",
      "text": "It also leaves urine nowhere to pool.",
      "start": 17.971,
      "end": 19.543,
      "wordRange": [
        73,
        79
      ]
    },
    {
      "id": "payoff",
      "text": "What reads as cost-cutting is a rule.",
      "start": 19.83,
      "end": 21.546,
      "wordRange": [
        80,
        86
      ]
    }
  ],
