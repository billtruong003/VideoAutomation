  "phrases": [
    {
      "id": "hook",
      "text": "Those brushes on the side of an escalator are not there to clean your shoes. They're warning you.",
      "start": 0.065,
      "end": 4.51,
      "wordRange": [
        0,
        17
      ]
    },
    {
      "id": "gap",
      "text": "The dangerous part is the tiny gap between the moving steps and the stationary side panel.",
      "start": 4.784,
      "end": 9.374,
      "wordRange": [
        18,
        33
      ]
    },
    {
      "id": "danger",
      "text": "Loose shoelaces, clothes, or bags can get caught there,",
      "start": 9.76,
      "end": 12.706,
      "wordRange": [
        34,
        42
      ]
    },
    {
      "id": "mechanism",
      "text": "so the brushes touch your shoes and naturally encourage you to move your feet away from the edge.",
      "start": 13.059,
      "end": 17.381,
      "wordRange": [
        43,
        60
      ]
    },
    {
      "id": "payoff",
      "text": "Basically, every time you rub your shoe against one because it feels nice, the escalator is politely asking you to stop standing next to the part that can eat it.",
      "start": 17.685,
      "end": 25.888,
      "wordRange": [
        61,
        90
      ]
    }
  ],
