  "source": "C:\\Users\\ducnq\\Downloads\\Video/episodes/coin-reeded-edges/subtitles-raw.json remapped through C:\\Users\\ducnq\\Downloads\\Video/public/audio/coin-reeded-edges.timemap.json",
  "audio": "public/audio/coin-reeded-edges.wav",
  "duration": 23.903,
  "tempo": 1.12,
  "segments": [
    {
      "text": "Run your thumb around the edge of a quarter",
      "start": 0.071,
      "end": 1.464
    },
    {
      "text": "and you'll feel ridges,",
      "start": 1.518,
      "end": 2.286
    },
    {
      "text": "which is a strange thing to put on a",
      "start": 2.526,
      "end": 3.723
    },
    {
      "text": "coin containing nothing worth stealing.",
      "start": 3.777,
      "end": 5.33
    },
    {
      "text": "Back when coins were actually silver,",
      "start": 5.673,
      "end": 7.192
    },
    {
      "text": "people shaved slivers off the rims,",
      "start": 7.437,
      "end": 8.865
    },
    {
      "text": "spent the coin anyway, and kept the shavings.",
      "start": 9.151,
      "end": 11.062
    },
    {
      "text": "A shaved coin looked almost normal.",
      "start": 11.385,
      "end": 13.3
    },
    {
      "text": "So mints cut grooves into the edge,",
      "start": 13.372,
      "end": 14.818
    },
    {
      "text": "and a shaved coin stopped looking normal immediately,",
      "start": 15.02,
      "end": 17.201
    },
    {
      "text": "because the pattern just ended.",
      "start": 17.407,
      "end": 18.738
    },
    {
      "text": "Isaac Newton used it against clippers as warden",
      "start": 18.846,
      "end": 20.756
    },
    {
      "text": "of the Royal Mint.",
      "start": 20.775,
      "end": 21.471
    },
    {
      "text": "The silver is long gone.",
      "start": 21.738,
      "end": 22.791
    },
    {
      "text": "The ridges stayed.",
      "start": 22.951,
      "end": 23.684
    }
  ],
