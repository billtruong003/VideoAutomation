  "phrases": [
    {
      "id": "hook",
      "text": "Run your thumb around the edge of a quarter and you'll feel ridges, which is a strange thing to put on a coin containing nothing worth stealing.",
      "start": 0.071,
      "end": 5.33,
      "wordRange": [
        0,
        26
      ]
    },
    {
      "id": "clipping",
      "text": "Back when coins were actually silver, people shaved slivers off the rims, spent the coin anyway, and kept the shavings. A shaved coin looked almost normal.",
      "start": 5.673,
      "end": 13.3,
      "wordRange": [
        27,
        52
      ]
    },
    {
      "id": "grooves",
      "text": "So mints cut grooves into the edge, and a shaved coin stopped looking normal immediately, because the pattern just ended.",
      "start": 13.372,
      "end": 18.738,
      "wordRange": [
        53,
        72
      ]
    },
    {
      "id": "newton",
      "text": "Isaac Newton used it against clippers as warden of the Royal Mint.",
      "start": 18.846,
      "end": 21.471,
      "wordRange": [
        73,
        84
      ]
    },
    {
      "id": "payoff",
      "text": "The silver is long gone. The ridges stayed.",
      "start": 21.738,
      "end": 23.684,
      "wordRange": [
        85,
        92
      ]
    }
  ],
