  "episode": "coin-reeded-edges",
  "title": "Your Quarter Is Still Protecting Silver It Doesn't Have",
  "audio": "public/audio/coin-reeded-edges.wav",
  "staticAudio": "audio/coin-reeded-edges.wav",
