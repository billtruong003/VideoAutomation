  "phrases": [
    {
      "id": "hook",
      "text": "The top of a soda can is visibly narrower than the rest of it, tapering inward just before the lid.",
      "start": 0.071,
      "end": 4.673,
      "wordRange": [
        0,
        19
      ]
    },
    {
      "id": "notmouth",
      "text": "That taper is not shaped for your mouth.",
      "start": 4.973,
      "end": 6.509,
      "wordRange": [
        20,
        27
      ]
    },
    {
      "id": "lid",
      "text": "The lid has to be much thicker than the walls, because it holds the pressure and carries a tab you can tear open with one finger.",
      "start": 6.786,
      "end": 12.215,
      "wordRange": [
        28,
        53
      ]
    },
    {
      "id": "saving",
      "text": "Thick metal is expensive metal, so shrinking the lid saves far more aluminum than shaving the sides ever could.",
      "start": 12.534,
      "end": 17.533,
      "wordRange": [
        54,
        72
      ]
    },
    {
      "id": "scale",
      "text": "Six millimeters have come off it since the sixties, saving close to two hundred million pounds a year.",
      "start": 17.921,
      "end": 22.36,
      "wordRange": [
        73,
        90
      ]
    }
  ],
