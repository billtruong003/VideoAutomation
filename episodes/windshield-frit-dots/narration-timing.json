  "phrases": [
    {
      "id": "hook",
      "text": "Look along the top edge of a windshield and you'll find a black border that breaks into a scatter of dots before it fades out.",
      "start": 0.106,
      "end": 5.276,
      "wordRange": [
        0,
        24
      ]
    },
    {
      "id": "ceramic",
      "text": "That border is ceramic paint baked into the glass, and it is covering the adhesive that holds the windshield onto the car.",
      "start": 5.542,
      "end": 11.259,
      "wordRange": [
        25,
        46
      ]
    },
    {
      "id": "glue",
      "text": "Sunlight would slowly cook that glue, so the black band shields it.",
      "start": 11.62,
      "end": 14.622,
      "wordRange": [
        47,
        58
      ]
    },
    {
      "id": "dots",
      "text": "The dots are the clever part.",
      "start": 14.857,
      "end": 15.964,
      "wordRange": [
        59,
        64
      ]
    },
    {
      "id": "thermal",
      "text": "Black glass heats faster than clear glass, and a hard edge between the two would build enough stress to crack the pane, so the dots spread that change out gradually.",
      "start": 16.235,
      "end": 23.654,
      "wordRange": [
        65,
        94
      ]
    }
  ],
