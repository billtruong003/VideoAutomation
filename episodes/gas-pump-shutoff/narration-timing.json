  "phrases": [
    {
      "id": "hook",
      "text": "Your gas pump knows when your tank is full without talking to your car.",
      "start": 0.082,
      "end": 3.512,
      "wordRange": [
        0,
        13
      ]
    },
    {
      "id": "nozzle",
      "text": "Near the tip of the nozzle is a tiny sensing hole connected to an air passage.",
      "start": 3.88,
      "end": 7.825,
      "wordRange": [
        14,
        29
      ]
    },
    {
      "id": "pumping",
      "text": "While you're pumping, air can move through it,",
      "start": 8.141,
      "end": 10.159,
      "wordRange": [
        30,
        37
      ]
    },
    {
      "id": "covered",
      "text": "but once the gasoline rises high enough to cover that hole, the airflow suddenly changes.",
      "start": 10.435,
      "end": 14.845,
      "wordRange": [
        38,
        52
      ]
    },
    {
      "id": "click",
      "text": "That pressure change triggers a mechanical diaphragm inside the nozzle and click. The valve shuts.",
      "start": 15.157,
      "end": 20.7,
      "wordRange": [
        53,
        67
      ]
    },
    {
      "id": "no-tech",
      "text": "No Wi-Fi, no computer, no secret signal from your car.",
      "start": 21.062,
      "end": 24.436,
      "wordRange": [
        68,
        77
      ]
    },
    {
      "id": "payoff",
      "text": "Just air pressure and a ridiculously clever little piece of mechanical engineering.",
      "start": 24.742,
      "end": 28.475,
      "wordRange": [
        78,
        89
      ]
    }
  ],
