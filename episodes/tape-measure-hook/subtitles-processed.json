  "tempo": 1.12,
  "segments": [
    {
      "text": "The metal hook on the end of a tape",
      "start": 0.071,
      "end": 1.34
    },
    {
      "text": "measure wobbles,",
      "start": 1.393,
      "end": 2.09
    },
    {
      "text": "and every time you notice it you assume the",
      "start": 2.289,
      "end": 3.825
    },
    {
      "text": "thing is worn out.",
      "start": 3.878,
      "end": 4.628
    },
    {
      "text": "The hook is supposed to move.",
      "start": 4.881,
      "end": 5.989
    },
    {
      "text": "It slides exactly as far as the hook is",
      "start": 6.263,
      "end": 8.174
    },
    {
      "text": "thick,",
      "start": 8.229,
      "end": 8.64
    },
    {
      "text": "about a sixteenth of an inch.",
      "start": 8.657,
      "end": 9.712
    },
    {
      "text": "Hook it over the edge of a board and",
      "start": 9.987,
      "end": 11.166
    },
    {
      "text": "it pulls out,",
      "start": 11.202,
      "end": 11.881
    },
    {
      "text": "adding that thickness back.",
      "start": 12.133,
      "end": 13.134
    },
    {
      "text": "Push it into a corner and it slides in,",
      "start": 13.392,
      "end": 15.107
    },
    {
      "text": "taking that thickness away.",
      "start": 15.378,
      "end": 16.576
    },
    {
      "text": "Either way the tape starts reading from true",
      "start": 16.878,
      "end": 18.896
    },
    {
      "text": "zero.",
      "start": 18.95,
      "end": 19.39
    },
    {
      "text": "The loosest part of the tool is the part",
      "start": 19.554,
      "end": 21.126
    },
    {
      "text": "keeping it honest.",
      "start": 21.162,
      "end": 21.877
    }
  ],
