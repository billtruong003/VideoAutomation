  "phrases": [
    {
      "id": "hook",
      "text": "The metal hook on the end of a tape measure wobbles, and every time you notice it you assume the thing is worn out. The hook is supposed to move.",
      "start": 0.071,
      "end": 5.989,
      "wordRange": [
        0,
        29
      ]
    },
    {
      "id": "slides",
      "text": "It slides exactly as far as the hook is thick, about a sixteenth of an inch.",
      "start": 6.263,
      "end": 9.712,
      "wordRange": [
        30,
        45
      ]
    },
    {
      "id": "outside",
      "text": "Hook it over the edge of a board and it pulls out, adding that thickness back.",
      "start": 9.987,
      "end": 13.134,
      "wordRange": [
        46,
        61
      ]
    },
    {
      "id": "inside",
      "text": "Push it into a corner and it slides in, taking that thickness away.",
      "start": 13.392,
      "end": 16.576,
      "wordRange": [
        62,
        74
      ]
    },
    {
      "id": "payoff",
      "text": "Either way the tape starts reading from true zero. The loosest part of the tool is the part keeping it honest.",
      "start": 16.878,
      "end": 21.877,
      "wordRange": [
        75,
        95
      ]
    }
  ],
