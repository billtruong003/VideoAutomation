  "episode": "tape-measure-hook",
  "title": "That Wobbly Tape Measure Hook Is Not Broken",
  "audio": "public/audio/tape-measure-hook.wav",
  "staticAudio": "audio/tape-measure-hook.wav",
  "duration": 22.121,
