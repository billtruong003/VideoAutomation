  "phrases": [
    {
      "id": "hook",
      "text": "A brick has holes punched straight through the middle, which is an odd thing to do to an object whose whole job is being solid.",
      "start": 0.088,
      "end": 5.299,
      "wordRange": [
        0,
        24
      ]
    },
    {
      "id": "better",
      "text": "The holes make it better.",
      "start": 5.55,
      "end": 6.532,
      "wordRange": [
        25,
        29
      ]
    },
    {
      "id": "mortar",
      "text": "Mortar squeezes down into them and sets there, so each brick is keyed into the one above rather than glued along a flat face.",
      "start": 6.834,
      "end": 12.544,
      "wordRange": [
        30,
        53
      ]
    },
    {
      "id": "firing",
      "text": "Wet clay also has to dry and fire without cracking, and heat reaches the middle of a perforated brick far faster than a solid lump.",
      "start": 12.878,
      "end": 19.395,
      "wordRange": [
        54,
        78
      ]
    },
    {
      "id": "payoff",
      "text": "Less clay, less fuel, lighter to lift, stronger wall.",
      "start": 19.715,
      "end": 22.789,
      "wordRange": [
        79,
        87
      ]
    }
  ],
