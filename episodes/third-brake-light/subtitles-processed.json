  "tempo": 1.12,
  "segments": [
    {
      "text": "Somewhere in the back window of every car sits",
      "start": 0.106,
      "end": 2.089
    },
    {
      "text": "a third brake light,",
      "start": 2.142,
      "end": 2.982
    },
    {
      "text": "higher and more centered than the other two.",
      "start": 3.228,
      "end": 4.855
    },
    {
      "text": "It exists because the original pair are easy",
      "start": 5.133,
      "end": 7.169
    },
    {
      "text": "to misread.",
      "start": 7.205,
      "end": 7.74
    },
    {
      "text": "They sit low,",
      "start": 7.977,
      "end": 8.567
    },
    {
      "text": "they sit far apart,",
      "start": 8.852,
      "end": 9.692
    },
    {
      "text": "and they are right beside tail lights that",
      "start": 9.924,
      "end": 11.372
    },
    {
      "text": "are already glowing.",
      "start": 11.407,
      "end": 12.139
    },
    {
      "text": "A single light up high,",
      "start": 12.422,
      "end": 13.477
    },
    {
      "text": "dark until the driver brakes,",
      "start": 13.78,
      "end": 15.083
    },
    {
      "text": "cannot be confused with anything.",
      "start": 15.34,
      "end": 16.68
    },
    {
      "text": "Early taxi-fleet trials suggested a third fewer",
      "start": 16.952,
      "end": 19.471
    },
    {
      "text": "rear-end collisions.",
      "start": 19.524,
      "end": 20.328
    },
    {
      "text": "Once every car had one the real figure settled",
      "start": 20.67,
      "end": 22.67
    },
    {
      "text": "nearer four percent,",
      "start": 22.706,
      "end": 23.546
    },
    {
      "text": "which is still tens of thousands of crashes",
      "start": 23.885,
      "end": 25.547
    },
    {
      "text": "a year.",
      "start": 25.599,
      "end": 26.135
    }
  ],
