  "phrases": [
    {
      "id": "hook",
      "text": "Somewhere in the back window of every car sits a third brake light, higher and more centered than the other two.",
      "start": 0.106,
      "end": 4.855,
      "wordRange": [
        0,
        20
      ]
    },
    {
      "id": "misread",
      "text": "It exists because the original pair are easy to misread.",
      "start": 5.133,
      "end": 7.687,
      "wordRange": [
        21,
        30
      ]
    },
    {
      "id": "lowwide",
      "text": "They sit low, they sit far apart, and they are right beside tail lights that are already glowing.",
      "start": 7.977,
      "end": 12.139,
      "wordRange": [
        31,
        48
      ]
    },
    {
      "id": "single",
      "text": "A single light up high, dark until the driver brakes, cannot be confused with anything.",
      "start": 12.422,
      "end": 16.68,
      "wordRange": [
        49,
        63
      ]
    },
    {
      "id": "trials",
      "text": "Early taxi-fleet trials suggested a third fewer rear-end collisions.",
      "start": 16.952,
      "end": 20.328,
      "wordRange": [
        64,
        72
      ]
    },
    {
      "id": "reality",
      "text": "Once every car had one the real figure settled nearer four percent, which is still tens of thousands of crashes a year.",
      "start": 20.67,
      "end": 25.903,
      "wordRange": [
        73,
        94
      ]
    }
  ],
