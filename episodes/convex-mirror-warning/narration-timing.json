  "phrases": [
    {
      "id": "hook",
      "text": "On an American car the passenger side mirror is curved, the driver's side one is flat, and only the curved one carries a warning printed on the glass.",
      "start": 0.071,
      "end": 6.685,
      "wordRange": [
        0,
        27
      ]
    },
    {
      "id": "curving",
      "text": "Curving a mirror squeezes a wider slice of road into the same piece of glass, which is how it covers a blind spot a flat mirror cannot reach.",
      "start": 7.007,
      "end": 13.573,
      "wordRange": [
        28,
        55
      ]
    },
    {
      "id": "price",
      "text": "The price is that everything in it looks smaller, and your brain reads smaller as further away.",
      "start": 13.857,
      "end": 17.931,
      "wordRange": [
        56,
        72
      ]
    },
    {
      "id": "payoff",
      "text": "The warning exists because the mirror really is misleading you, and someone decided that had to be admitted in writing.",
      "start": 18.231,
      "end": 22.95,
      "wordRange": [
        73,
        92
      ]
    }
  ],
