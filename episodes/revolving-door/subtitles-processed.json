  "tempo": 1.12,
  "segments": [
    {
      "text": "A revolving door is slower than a normal door,",
      "start": 0.071,
      "end": 2.215
    },
    {
      "text": "more expensive to build,",
      "start": 2.52,
      "end": 3.467
    },
    {
      "text": "and much harder to carry anything through,",
      "start": 3.715,
      "end": 5.27
    },
    {
      "text": "and tall buildings keep installing them anyway.",
      "start": 5.463,
      "end": 7.249
    },
    {
      "text": "Warm air inside a tall building rises and escapes",
      "start": 7.576,
      "end": 9.936
    },
    {
      "text": "out of the top,",
      "start": 9.971,
      "end": 10.543
    },
    {
      "text": "and that pulls cold air in hard at street",
      "start": 10.753,
      "end": 12.433
    },
    {
      "text": "level.",
      "start": 12.486,
      "end": 12.83
    },
    {
      "text": "On an ordinary door,",
      "start": 12.978,
      "end": 13.978
    },
    {
      "text": "that pressure difference turns the entrance",
      "start": 14.3,
      "end": 15.943
    },
    {
      "text": "into a wind tunnel and throws the heating out",
      "start": 15.979,
      "end": 17.888
    },
    {
      "text": "into the street.",
      "start": 17.905,
      "end": 18.531
    },
    {
      "text": "A revolving door never actually opens.",
      "start": 18.788,
      "end": 20.682
    },
    {
      "text": "Only the wedge of air in your compartment travels",
      "start": 20.983,
      "end": 23.002
    },
    {
      "text": "with you.",
      "start": 23.038,
      "end": 23.574
    }
  ],
