  "phrases": [
    {
      "id": "hook",
      "text": "A revolving door is slower than a normal door, more expensive to build, and much harder to carry anything through, and tall buildings keep installing them anyway.",
      "start": 0.071,
      "end": 7.249,
      "wordRange": [
        0,
        26
      ]
    },
    {
      "id": "stack",
      "text": "Warm air inside a tall building rises and escapes out of the top, and that pulls cold air in hard at street level.",
      "start": 7.576,
      "end": 12.719,
      "wordRange": [
        27,
        49
      ]
    },
    {
      "id": "windtunnel",
      "text": "On an ordinary door, that pressure difference turns the entrance into a wind tunnel and throws the heating out into the street.",
      "start": 12.978,
      "end": 18.531,
      "wordRange": [
        50,
        71
      ]
    },
    {
      "id": "neveropens",
      "text": "A revolving door never actually opens.",
      "start": 18.788,
      "end": 20.682,
      "wordRange": [
        72,
        77
      ]
    },
    {
      "id": "payoff",
      "text": "Only the wedge of air in your compartment travels with you.",
      "start": 20.983,
      "end": 23.342,
      "wordRange": [
        78,
        88
      ]
    }
  ],
