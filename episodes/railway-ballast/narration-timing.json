  "phrases": [
    {
      "id": "hook",
      "text": "Train tracks sit on a bed of sharp, angular gravel, and it is there on purpose.",
      "start": 0.106,
      "end": 3.924,
      "wordRange": [
        0,
        15
      ]
    },
    {
      "id": "load",
      "text": "A loaded train puts enormous weight onto a thin steel rail, and the stones spread that load sideways so the ground underneath does not sink.",
      "start": 4.226,
      "end": 10.724,
      "wordRange": [
        16,
        40
      ]
    },
    {
      "id": "interlock",
      "text": "Because they are angular rather than rounded, they lock against each other and stop the track creeping out of line.",
      "start": 10.976,
      "end": 15.683,
      "wordRange": [
        41,
        60
      ]
    },
    {
      "id": "drainage",
      "text": "Rain drains through the gaps instead of turning the bed to mud.",
      "start": 16.04,
      "end": 18.47,
      "wordRange": [
        61,
        72
      ]
    },
    {
      "id": "vibration",
      "text": "And the layer soaks up vibration, which is why a passing train shakes the ground less than it should.",
      "start": 18.755,
      "end": 22.952,
      "wordRange": [
        73,
        91
      ]
    }
  ],
