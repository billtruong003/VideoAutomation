  "phrases": [
    {
      "id": "hook",
      "text": "One side of aluminum foil is shiny and the other side is dull, and the box never explains why.",
      "start": 0.071,
      "end": 4.336,
      "wordRange": [
        0,
        18
      ]
    },
    {
      "id": "notcoating",
      "text": "It is not a coating, and it is not a nonstick side.",
      "start": 4.62,
      "end": 7.115,
      "wordRange": [
        19,
        30
      ]
    },
    {
      "id": "mill",
      "text": "Foil gets rolled thinner and thinner between polished steel rollers, and by the last pass it is so thin a single sheet would tear itself apart, so the mill runs two sheets through stacked together.",
      "start": 7.492,
      "end": 16.851,
      "wordRange": [
        31,
        65
      ]
    },
    {
      "id": "outer",
      "text": "The outer faces press against mirror-bright steel and come out shiny.",
      "start": 17.12,
      "end": 20.428,
      "wordRange": [
        66,
        76
      ]
    },
    {
      "id": "inner",
      "text": "The two inner faces press against each other and come out dull.",
      "start": 20.722,
      "end": 23.526,
      "wordRange": [
        77,
        88
      ]
    }
  ],
