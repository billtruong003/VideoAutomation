  "phrases": [
    {
      "id": "hook",
      "text": "That tiny hole in your airplane window is supposed to be there.",
      "start": 0.041,
      "end": 3.078,
      "wordRange": [
        0,
        11
      ]
    },
    {
      "id": "layers",
      "text": "Passenger windows use multiple layers, and that little breather hole sits in one of the inner panes.",
      "start": 3.422,
      "end": 8.655,
      "wordRange": [
        12,
        28
      ]
    },
    {
      "id": "pressure",
      "text": "It helps manage the pressure between the layers, so the outer structural pane takes most of the pressure difference while you're flying at altitude.",
      "start": 8.962,
      "end": 15.753,
      "wordRange": [
        29,
        52
      ]
    },
    {
      "id": "moisture",
      "text": "It also helps moisture escape from between the panes.",
      "start": 16.052,
      "end": 18.571,
      "wordRange": [
        53,
        61
      ]
    },
    {
      "id": "verdict",
      "text": "So no, your airplane window does not have a manufacturing defect.",
      "start": 18.924,
      "end": 22.317,
      "wordRange": [
        62,
        72
      ]
    },
    {
      "id": "payoff",
      "text": "That suspicious little hole is actually part of the reason the window works in the 1st place.",
      "start": 22.615,
      "end": 26.67,
      "wordRange": [
        73,
        89
      ]
    }
  ],
