  "audio": "public/audio/thermal-receipt-fade.wav",
  "duration": 24.52,
  "tempo": 1.12,
  "segments": [
    {
      "text": "A receipt left in a wallet slowly goes blank,",
      "start": 0.053,
      "end": 1.983
    },
    {
      "text": "because there was never any ink on it.",
      "start": 2.196,
      "end": 3.518
    },
    {
      "text": "Receipt paper is coated with a colorless dye",
      "start": 3.803,
      "end": 5.803
    },
    {
      "text": "and a chemical developer sitting right next",
      "start": 6.028,
      "end": 7.654
    },
    {
      "text": "to each other, doing nothing.",
      "start": 7.689,
      "end": 8.941
    },
    {
      "text": "The printer has no ink and no ribbon.",
      "start": 9.182,
      "end": 10.86
    },
    {
      "text": "It has a row of tiny heaters.",
      "start": 11.12,
      "end": 12.425
    },
    {
      "text": "Wherever it touches, the coating melts,",
      "start": 12.719,
      "end": 14.576
    },
    {
      "text": "the two chemicals meet,",
      "start": 14.776,
      "end": 15.705
    },
    {
      "text": "and that spot turns black.",
      "start": 15.92,
      "end": 17.063
    },
    {
      "text": "The catch is the reaction never locks.",
      "start": 17.323,
      "end": 19.325
    },
    {
      "text": "Heat off a dashboard or friction in a back",
      "start": 19.598,
      "end": 21.956
    },
    {
      "text": "pocket keeps driving it until the text vanishes.",
      "start": 22.009,
      "end": 24.283
    }
  ],
