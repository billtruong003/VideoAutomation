  "phrases": [
    {
      "id": "hook",
      "text": "A receipt left in a wallet slowly goes blank, because there was never any ink on it.",
      "start": 0.053,
      "end": 3.518,
      "wordRange": [
        0,
        16
      ]
    },
    {
      "id": "coating",
      "text": "Receipt paper is coated with a colorless dye and a chemical developer sitting right next to each other, doing nothing.",
      "start": 3.803,
      "end": 8.941,
      "wordRange": [
        17,
        36
      ]
    },
    {
      "id": "heaters",
      "text": "The printer has no ink and no ribbon. It has a row of tiny heaters.",
      "start": 9.182,
      "end": 12.425,
      "wordRange": [
        37,
        51
      ]
    },
    {
      "id": "reaction",
      "text": "Wherever it touches, the coating melts, the two chemicals meet, and that spot turns black.",
      "start": 12.719,
      "end": 17.063,
      "wordRange": [
        52,
        66
      ]
    },
    {
      "id": "fade",
      "text": "The catch is the reaction never locks. Heat off a dashboard or friction in a back pocket keeps driving it until the text vanishes.",
      "start": 17.323,
      "end": 24.283,
      "wordRange": [
        67,
        90
      ]
    }
  ],
