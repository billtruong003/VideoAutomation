  "source": "C:\\Users\\ducnq\\Downloads\\Video/episodes/sneaker-lace-lock/subtitles-raw.json remapped through C:\\Users\\ducnq\\Downloads\\Video/public/audio/sneaker-lace-lock.timemap.json",
  "audio": "public/audio/sneaker-lace-lock.wav",
  "duration": 20.87,
  "tempo": 1.12,
  "segments": [
    {
      "text": "Almost every sneaker has one extra lace hole",
      "start": 0.071,
      "end": 2.233
    },
    {
      "text": "at the top that nobody uses,",
      "start": 2.25,
      "end": 3.555
    },
    {
      "text": "set slightly back from the rest.",
      "start": 3.836,
      "end": 5.156
    },
    {
      "text": "Thread the lace through it on each side",
      "start": 5.463,
      "end": 7.071
    },
    {
      "text": "and you get a small loop above the ankle.",
      "start": 7.275,
      "end": 8.83
    },
    {
      "text": "Cross the laces into the opposite loop,",
      "start": 9.066,
      "end": 10.712
    },
    {
      "text": "pull,",
      "start": 10.979,
      "end": 11.371
    },
    {
      "text": "and the collar clamps down around your ankle",
      "start": 11.388,
      "end": 13.104
    },
    {
      "text": "instead of squeezing the middle of your foot.",
      "start": 13.157,
      "end": 14.819
    },
    {
      "text": "Your heel stops lifting out of the shoe with",
      "start": 15.094,
      "end": 16.755
    },
    {
      "text": "every step.",
      "start": 16.827,
      "end": 17.363
    },
    {
      "text": "Heel lift is what rubs a blister into the",
      "start": 17.626,
      "end": 19.235
    },
    {
      "text": "back of your foot on a long walk.",
      "start": 19.324,
      "end": 20.664
    }
  ],
