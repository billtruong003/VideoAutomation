  "phrases": [
    {
      "id": "hook",
      "text": "Almost every sneaker has one extra lace hole at the top that nobody uses, set slightly back from the rest.",
      "start": 0.071,
      "end": 5.156,
      "wordRange": [
        0,
        19
      ]
    },
    {
      "id": "thread",
      "text": "Thread the lace through it on each side and you get a small loop above the ankle.",
      "start": 5.463,
      "end": 8.83,
      "wordRange": [
        20,
        36
      ]
    },
    {
      "id": "cross",
      "text": "Cross the laces into the opposite loop, pull, and the collar clamps down around your ankle instead of squeezing the middle of your foot.",
      "start": 9.066,
      "end": 14.819,
      "wordRange": [
        37,
        60
      ]
    },
    {
      "id": "heel",
      "text": "Your heel stops lifting out of the shoe with every step.",
      "start": 15.094,
      "end": 17.345,
      "wordRange": [
        61,
        71
      ]
    },
    {
      "id": "blister",
      "text": "Heel lift is what rubs a blister into the back of your foot on a long walk.",
      "start": 17.626,
      "end": 20.664,
      "wordRange": [
        72,
        88
      ]
    }
  ],
