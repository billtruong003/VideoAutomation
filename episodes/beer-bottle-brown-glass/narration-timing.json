  "episode": "beer-bottle-brown-glass",
  "title": "Light Turns Beer Into Something Close To Skunk Spray",
  "audio": "public/audio/beer-bottle-brown-glass.wav",
  "staticAudio": "audio/beer-bottle-brown-glass.wav",
