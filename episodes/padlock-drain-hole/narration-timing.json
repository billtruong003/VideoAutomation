  "phrases": [
    {
      "id": "hook",
      "text": "Flip a padlock over and there is a small hole in the bottom of it, which looks like an excellent way to let water into an expensive lock.",
      "start": 0.106,
      "end": 6.141,
      "wordRange": [
        0,
        27
      ]
    },
    {
      "id": "opposite",
      "text": "It does the opposite.",
      "start": 6.41,
      "end": 7.161,
      "wordRange": [
        28,
        31
      ]
    },
    {
      "id": "moisture",
      "text": "A padlock left outdoors collects moisture no matter what you do, from rain, from washing, from the air itself.",
      "start": 7.368,
      "end": 13.134,
      "wordRange": [
        32,
        50
      ]
    },
    {
      "id": "rust",
      "text": "Sealed shut, that water sits on steel springs and pins until they rust into a solid lump, or freeze there overnight.",
      "start": 13.497,
      "end": 19.562,
      "wordRange": [
        51,
        71
      ]
    },
    {
      "id": "drains",
      "text": "The hole lets it fall straight back out.",
      "start": 19.809,
      "end": 21.488,
      "wordRange": [
        72,
        79
      ]
    },
    {
      "id": "oil",
      "text": "It also gives you somewhere to put a drop of oil.",
      "start": 21.765,
      "end": 23.659,
      "wordRange": [
        80,
        90
      ]
    }
  ],
