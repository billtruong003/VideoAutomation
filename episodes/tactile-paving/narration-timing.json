  "phrases": [
    {
      "id": "hook",
      "text": "Those bumpy tiles at the edge of a train platform are a language, and it only has two words.",
      "start": 0.088,
      "end": 4.114,
      "wordRange": [
        0,
        18
      ]
    },
    {
      "id": "domes",
      "text": "Round domes mean stop, because there is an edge, a road, or a drop ahead.",
      "start": 4.43,
      "end": 8.82,
      "wordRange": [
        19,
        33
      ]
    },
    {
      "id": "bars",
      "text": "Long parallel bars mean keep going, this way is safe.",
      "start": 9.186,
      "end": 12.063,
      "wordRange": [
        34,
        43
      ]
    },
    {
      "id": "readable",
      "text": "Both are readable through a shoe or the tip of a cane, and the yellow helps if you still have some sight.",
      "start": 12.391,
      "end": 16.858,
      "wordRange": [
        44,
        65
      ]
    },
    {
      "id": "miyake",
      "text": "An engineer in Japan named Seiichi Miyake paid for the first ones himself in 1965, because a friend was going blind.",
      "start": 17.112,
      "end": 23.74,
      "wordRange": [
        66,
        86
      ]
    },
    {
      "id": "payoff",
      "text": "They are under most of the world's feet now.",
      "start": 24.051,
      "end": 25.586,
      "wordRange": [
        87,
        95
      ]
    }
  ],
