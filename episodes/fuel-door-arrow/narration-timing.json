  "phrases": [
    {
      "id": "hook",
      "text": "Your car may have been answering this question your entire life.",
      "start": 0.07,
      "end": 2.82,
      "wordRange": [
        0,
        10
      ]
    },
    {
      "id": "symbol",
      "text": "Look at the little fuel pump symbol on your dashboard.",
      "start": 3.13,
      "end": 5.382,
      "wordRange": [
        11,
        20
      ]
    },
    {
      "id": "arrow",
      "text": "On many cars, there's a tiny arrow or triangle beside it.",
      "start": 5.692,
      "end": 8.747,
      "wordRange": [
        21,
        31
      ]
    },
    {
      "id": "left-right",
      "text": "If it points left, your fuel door is on the left. If it points right, it's on the right.",
      "start": 9.043,
      "end": 13.483,
      "wordRange": [
        32,
        50
      ]
    },
    {
      "id": "why",
      "text": "Manufacturers don't all put fuel doors on the same side, so this tiny symbol saves you from guessing,",
      "start": 13.845,
      "end": 18.937,
      "wordRange": [
        51,
        68
      ]
    },
    {
      "id": "regret",
      "text": "which means every time you pulled into a gas station, chose the wrong pump, reversed, and tried again,",
      "start": 19.252,
      "end": 24.421,
      "wordRange": [
        69,
        86
      ]
    },
    {
      "id": "payoff",
      "text": "the answer may have been glowing directly in front of your face.",
      "start": 24.725,
      "end": 27.26,
      "wordRange": [
        87,
        98
      ]
    }
  ],
