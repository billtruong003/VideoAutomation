  "phrases": [
    {
      "id": "hook",
      "text": "That tiny hole in some pen caps can serve a much more serious purpose than you'd expect.",
      "start": 0.039,
      "end": 4.469,
      "wordRange": [
        0,
        16
      ]
    },
    {
      "id": "vented",
      "text": "On vented caps, such as the Bic Cristal, the opening is there for safety.",
      "start": 4.782,
      "end": 8.691,
      "wordRange": [
        17,
        30
      ]
    },
    {
      "id": "airway",
      "text": "If someone accidentally inhales the cap and it gets lodged in the airway, the vent may still allow some air to pass through while emergency help is needed.",
      "start": 9.007,
      "end": 16.877,
      "wordRange": [
        31,
        58
      ]
    },
    {
      "id": "standards",
      "text": "International safety standards specifically address vented pen caps for this reason.",
      "start": 17.201,
      "end": 21.542,
      "wordRange": [
        59,
        69
      ]
    },
    {
      "id": "payoff",
      "text": "So one of the cheapest, most forgettable pieces of plastic on your desk has a design feature meant for an emergency where a few extra breaths could matter.",
      "start": 21.893,
      "end": 29.285,
      "wordRange": [
        70,
        97
      ]
    }
  ],
