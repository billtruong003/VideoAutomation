  "phrases": [
    {
      "id": "hook",
      "text": "The cabin lights go down before a night landing, and it reads as mood lighting or saving power.",
      "start": 0.071,
      "end": 4.233,
      "wordRange": [
        0,
        17
      ]
    },
    {
      "id": "neither",
      "text": "It is neither.",
      "start": 4.522,
      "end": 5.093,
      "wordRange": [
        18,
        20
      ]
    },
    {
      "id": "adapt",
      "text": "Eyes take several minutes to adapt to darkness, and takeoff and landing are when an evacuation is most likely to be needed.",
      "start": 5.416,
      "end": 10.915,
      "wordRange": [
        21,
        42
      ]
    },
    {
      "id": "blind",
      "text": "If the cabin were brightly lit and the power went, everyone aboard would be effectively blind at the worst possible moment.",
      "start": 11.243,
      "end": 16.681,
      "wordRange": [
        43,
        63
      ]
    },
    {
      "id": "payoff",
      "text": "Dimming early means your eyes are already adjusted, and the floor path lighting reads clearly instead of washing out. The lights go down so you can see.",
      "start": 17.025,
      "end": 24.124,
      "wordRange": [
        64,
        90
      ]
    }
  ],
