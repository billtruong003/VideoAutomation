  "episode": "cabin-lights-dim",
  "title": "Why The Cabin Lights Go Down Before Landing",
  "audio": "public/audio/cabin-lights-dim.wav",
  "staticAudio": "audio/cabin-lights-dim.wav",
  "duration": 24.328,
